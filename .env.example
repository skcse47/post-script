# ── Required Secrets ─────────────────────────────────────────────
# Binance Square OpenAPI key (from Creator Center -> AI Skills)
BINANCE_SQUARE_API_KEY=your_binance_square_api_key_here

# ── LLM Provider Configuration ──────────────────────────────────
# Set to '1' or 'gemini' for Google Gemini
# Set to '2' or 'openrouter' for OpenRouter
LLM_PROVIDER=openrouter

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier
# Examples for OpenRouter:
#   qwen/qwen3-next-80b-a3b-instruct
#   qwen/qwen-2.5-7b-instruct
#   meta-llama/llama-3.1-8b-instruct:free
# Examples for Gemini:
#   gemini-2.0-flash
#   gemini-2.5-flash
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct

# ── Posting Behaviour ───────────────────────────────────────────
# Minutes between posts. The old default of 15 meant 96 posts a day from one
# account, which suppressed its own reach and burned readers. Fewer, better posts
# reach more people in total.
POST_INTERVAL_MINUTES=45

# Hours before the same coin can be posted about again. Stops the feed showing
# the same ticker three times in a morning.
COIN_COOLDOWN_HOURS=6
