# ── LLM Provider Configuration ──────────────────────────────────
# Set to '1' or 'gemini' for Google Gemini
# Set to '2' or 'openrouter' for OpenRouter
LLM_PROVIDER=openrouter

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY = sk-or-v1-e90c6dc82838c372ff2655b143450a
# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyBH1BgJp_twyVsPyXtPBqWaxwKtpQgl9bM

# Model identifier
# Examples for OpenRouter:
#   qwen/qwen-2.5-7b-instruct
#   qwen/qwen-2.5-3b-instruct
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemini-2.0-flash-exp:free
# Examples for Gemini:
#   gemini-2.0-flash
#   gemini-2.5-flash
LLM_MODEL=qwen/qwen-2.5-7b-instruct
